{
  "name": "winebrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental browser-local PE runtime with x86 basic-block translation to WebAssembly",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "build:demos": "bash scripts/build-demos.sh",
    "predev": "node scripts/prepare-decoder.mjs",
    "prebuild": "node scripts/prepare-decoder.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect:targets": "node scripts/inspect-targets.mjs",
    "test:external": "node scripts/test-external-browser.mjs",
    "fetch:targets": "node scripts/fetch-targets.mjs",
    "build:wine": "python3 scripts/build-wine-library.py",
    "build:modules": "bash scripts/build-module-fixtures.sh",
    "test:wine": "node scripts/test-wine-ntdll.mjs",
    "probe:wine-crt": "node scripts/probe-wine-crt.mjs",
    "build:tls": "bash scripts/build-tls-fixtures.sh"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "iced-x86": "1.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
