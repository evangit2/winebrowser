{
  "name": "winebrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental browser-local PE runtime with x86 basic-block translation to WebAssembly",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test:windows": "node scripts/test-windows-browser.mjs",
    "build:windows": "bash scripts/build-window-demo.sh",
    "build:examples": "python3 scripts/package-examples.py",
    "test:tetris": "node scripts/test-tetris-browser.mjs",
    "test:controls": "node scripts/test-desktop-controls.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "build:demos": "bash scripts/build-demos.sh",
    "predev": "node scripts/prepare-decoder.mjs",
    "prebuild": "node scripts/prepare-decoder.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect:targets": "node scripts/inspect-targets.mjs",
    "test:external": "node scripts/test-external-browser.mjs",
    "fetch:targets": "node scripts/fetch-targets.mjs",
    "build:wine": "python3 scripts/build-wine-library.py",
    "build:modules": "bash scripts/build-module-fixtures.sh",
    "test:wine": "node scripts/test-wine-ntdll.mjs",
    "probe:wine-crt": "node scripts/probe-wine-crt.mjs",
    "build:tls": "bash scripts/build-tls-fixtures.sh",
    "build:wine-format": "python3 scripts/build-wine-format.py",
    "build:wine-loader": "python3 scripts/build-wine-loader.py",
    "probe:wine-loader": "node scripts/probe-wine-loader.mjs",
    "probe:wine-loader-crt": "node scripts/probe-wine-loader-crt.mjs",
    "probe:wine-target": "node scripts/probe-wine-target.mjs",
    "build:d3d9": "bash scripts/build-d3d9-demo.sh",
    "build:d3d9-shader-cube": "bash scripts/build-d3d9-shader-cube.sh",
    "test:webgpu": "node scripts/test-webgpu-backend.mjs",
    "test:d3d9": "node scripts/test-d3d9-browser.mjs",
    "test:d3d9-shader-cube": "node scripts/test-d3d9-shader-cube-browser.mjs",
    "build:d3d12": "bash scripts/build-d3d12-demo.sh",
    "build:d3d12-cube": "bash scripts/build-d3d12-cube.sh",
    "build:shader-dxbc": "python3 scripts/build-shader-dxbc.py",
    "build:shader-wgsl": "bash scripts/build-shader-wgsl.sh",
    "test:shaders": "node scripts/test-dxbc-browser.mjs",
    "test:d3d12": "node scripts/test-d3d12-browser.mjs",
    "test:d3d12-backend": "node scripts/test-d3d12-backend.mjs",
    "test:d3d12-cube": "node scripts/test-d3d12-browser.mjs --cube",
    "build:softfloat": "python3 scripts/build-softfloat.py",
    "test:softfloat": "node runtime/softfloat/test.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "iced-x86": "1.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
