#include <windows.h>
101 DIALOGEX 0, 0, 230, 100
STYLE DS_CONTROL | WS_CHILD
CAPTION "General"
BEGIN
 LTEXT "Edit a native DLL page", -1, 8, 8, 180, 12
 EDITTEXT 10, 8, 26, 180, 16, ES_AUTOHSCROLL | WS_TABSTOP
 CONTROL "Keep this page active", 11, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 52, 180, 16
 LTEXT "General ready", 12, 8, 76, 210, 14
END
102 DIALOGEX 0, 0, 230, 100
STYLE DS_CONTROL | WS_CHILD
CAPTION "Appearance"
BEGIN
 CONTROL "Reject Apply", 20, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 8, 170, 16
 CONTROL "Reject Cancel", 21, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 30, 170, 16
 LTEXT "Appearance ready", 22, 8, 64, 210, 14
END
