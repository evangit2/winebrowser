#include <windows.h>
101 DIALOG 0,0,220,90
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Classic resource font"
FONT 12,"Arial"
BEGIN
  LTEXT "Classic font caption",10,8,8,170,16
  EDITTEXT 11,8,30,120,18,ES_AUTOHSCROLL
  DEFPUSHBUTTON "Close",1,150,60,60,20
END
102 DIALOGEX 0,0,220,90
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Extended resource font verified"
FONT 11,"Arial",700,1,1
BEGIN
  LTEXT "Bold italic resource caption",10,8,8,190,16
  EDITTEXT 11,8,30,120,18,ES_AUTOHSCROLL
  DEFPUSHBUTTON "Close",1,150,60,60,20
END
103 DIALOG 0,0,220,90
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fontless resource"
BEGIN
  LTEXT "Default dialog units",10,8,8,170,16
  EDITTEXT 11,8,30,120,18,ES_AUTOHSCROLL
  DEFPUSHBUTTON "Close",1,150,60,60,20
END
