#version 450
layout(local_size_x = 4) in;
layout(set = 0, binding = 0, std430) buffer Data { uint values[]; } data;
layout(push_constant) uniform Parameters { uint increment; } parameters;
void main() {
  uint index = gl_GlobalInvocationID.x;
  data.values[index] = data.values[index] * 2u + parameters.increment;
}
